# App
PORT=3000
NODE_ENV=development
# Gerado com: openssl rand -hex 32
MASTER_API_KEY=change-me-in-production

# Auth (JWT — gerar secret com: openssl rand -hex 32)
JWT_SECRET=change-me-min-32-chars
JWT_EXPIRES_IN=1d

# PostgreSQL (local)
POSTGRES_USER=trafegoflow
POSTGRES_PASSWORD=trafegoflow
POSTGRES_DB=trafegoflow
DATABASE_URL=postgresql://trafegoflow:trafegoflow@localhost:5432/trafegoflow
# PostgreSQL (produção - Supabase): Settings > Database > Connection string (URI)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Redis (local)
REDIS_PASSWORD=trafegoflow
REDIS_URL=redis://:trafegoflow@localhost:6379
# Redis (produção - Upstash): Data > REST API > REDIS_URL
# REDIS_URL=rediss://default:[password]@[host]:[port]
CACHE_TTL_SECONDS=3600

# Criptografia de tokens Meta (AES-256-GCM — gerar com: openssl rand -hex 32)
ENCRYPTION_KEY=change-me-64-hex-chars

# Meta / Instagram + WhatsApp (Webhooks & Messaging)
META_APP_SECRET=<app_secret_do_facebook_developer_console>
META_VERIFY_TOKEN=<string_aleatoria_configurada_no_painel_meta>
META_GRAPH_API_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v21.0

# Meta / Marketing API (Campaign Reports)
# Requer User Access Token de longa duração ou System User Token com permissão ads_read
META_ADS_API_VERSION=v21.0
INSIGHTS_CACHE_TTL_SECONDS=300

# WhatsApp Weekly Reports (Baileys)
# Número dedicado para envio de relatórios (ex: +5511999999999)
WHATSAPP_DEDICATED_PHONE=+5511999999999
# A sessão Baileys (auth state do Signal) é persistida no Postgres (tabela whatsapp_auth_keys)

# (Futuro — módulo Bot)
# OPENAI_API_KEY=
